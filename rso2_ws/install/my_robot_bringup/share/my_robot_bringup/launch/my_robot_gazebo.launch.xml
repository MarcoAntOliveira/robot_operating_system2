<?xml version="1.0"?>
<launch>
    <!-- Lançamento do simulador Gazebo -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
       <arg name="gz_args" value="$(find-pkg-share ros_gz_sim)/worlds/empty.sdf -r"/>
    </include>
  <let name ="gazebo_config_path"
        value="$(find-pkg-share my_robot_bringup)/config/gazebo_bridge.yaml"/>
    <!-- Estado do robô via xacro -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro')"/>
    </node>
     <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" >
         <arg name="gz_args" value="empty.sdf -r"/>
    </include>
  <!-- <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" output="screen">
    <arg name="gz_args" value="empty.sdf -r"/>
</include> -->

    <!-- Publicação para o Gazebo Sim -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"/>

    <!-- Interface gráfica para publicação dos joints -->
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"/>

    <!-- RViz com configuração personalizada -->
    <node pkg="rviz2" exec="rviz2" output="screen"
          args="-d $(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>



    <node pkg = "ros_gz_bridge" exec="parameter_bridge">
      <param name="config_file" value="$(var gazebo_config_path)"/>
    </node>
</launch>
